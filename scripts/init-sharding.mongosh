// Conecta no mongos e faz setup de sharding
// Roda com: mongosh mongodb://mongos:27017 < init-sharding.mongosh

try {
  print('🔗 Adicionando shards...');
  sh.addShard('rs0/shard1:27017');
  sh.addShard('rs1/shard2:27017');
  sh.addShard('rs2/shard3:27017');
  print('✅ Shards adicionados');

  print('📊 Habilitando sharding no banco...');
  sh.enableSharding('customers');
  print('✅ Sharding habilitado');

  print('📑 Preparando índice hashed no CPF...');
  use('customers');

  try {
    db.customers.dropIndex('cpf_hashed');
  } catch (e) {
    // Pode não existir, é ok
  }

  db.customers.createIndex({ cpf: 'hashed' });
  print('✅ Índice hashed criado');

  print('🗄️ Habilitando sharding na collection...');
  sh.shardCollection('customers.customers', { cpf: 'hashed' });
  print('✅ Collection sharding habilitado com hashed distribution');

  print('');
  print('🎉 SHARDING INICIALIZADO COM SUCESSO!');
  print('');
} catch (error) {
  print('❌ Erro: ' + error.message);
  quit(1);
}
